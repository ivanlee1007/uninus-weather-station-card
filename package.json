{
  "name": "uninus-weather-station-card",
  "version": "0.3.1",
  "description": "Responsive UNINUS weather station and wind rose card for Home Assistant Lovelace",
  "main": "uninus-weather-station-card.js",
  "type": "module",
  "scripts": {
    "http-server": "http-server ./",
    "lint": "npx eslint .",
    "typecheck": "tsc --noEmit",
    "build": "npm run esbuild-uninus",
    "esbuild": "npm run esbuild-windrose && npm run esbuild-uninus",
    "esbuild-windrose": "esbuild src/card/WindRoseCard.ts --bundle --minify --target=es2017 --outfile=build/windrose-card.js && node scripts/normalize-build-output.cjs build/windrose-card.js",
    "esbuild-uninus": "esbuild src/uninus/UninusWeatherStationCard.ts --bundle --minify --target=es2017 --outfile=build/uninus-weather-station-card.js && node scripts/normalize-build-output.cjs build/uninus-weather-station-card.js && node -e \"require('node:fs').copyFileSync('build/uninus-weather-station-card.js', 'uninus-weather-station-card.js')\"",
    "esbuild-watch": "esbuild src/card/WindRoseCard.ts --bundle --minify --target=es2017 --outfile=build/windrose-card.js --watch",
    "esbuild-uninus-watch": "esbuild src/uninus/UninusWeatherStationCard.ts --bundle --minify --target=es2017 --outfile=build/uninus-weather-station-card.js --watch",
    "test": "jest --runInBand"
  },
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "automation",
    "lovelace",
    "custom-cards",
    "windrose",
    "weather-station",
    "uninus",
    "taiwan"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@eslint/js": "^9.39.4",
    "@jest/globals": "^29.7.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "babel-jest": "^29.7.0",
    "deepmerge": "^4.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@lit-labs/scoped-registry-mixin": "^1.0.3",
    "@svgdotjs/svg.js": "^3.2.5",
    "@vvo/tzdb": "^6.198.0",
    "date-fns": "^4.1.0",
    "home-assistant-js-websocket": "^9.6.0",
    "lit": "^3.3.2",
    "memoize-one": "^6.0.0"
  }
}
